{
  "name": "@avalon-app/core",
  "version": "1.0.0",
  "description": "A framework-agnostic game engine for The Resistance: Avalon — handles character dealing, quest flow, team voting, Lady of the Lake, Excalibur, Lancelot rules, and assassination, so you can focus on building the UI.",
  "repository": {
    "type": "git",
    "url": "git+https://git@github.com:avalon-app/core.git"
  },
  "homepage": "https://github.com/avalon-app/core#readme",
  "bugs": {
    "url": "https://github.com/avalon-app/core/issues"
  },
  "author": "Heng Yin <maple1058@hotmail.com>",
  "license": "MIT",
  "keywords": [
    "avalon",
    "game",
    "board-game",
    "resistance"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --verbose",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.10",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.0.0"
}
