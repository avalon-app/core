{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["jest"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    // Required by tsup's declaration build, which sets the "baseUrl" option deprecated in TypeScript 6.
    // Without it `pnpm build` fails with TS5101. Revisit when tsup stops setting "baseUrl".
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "tests"]
}
